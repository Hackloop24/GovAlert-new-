# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# ---- Required ----
# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/govapp

# Secret used to sign login tokens: a random string of at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin account (created/updated each time the backend starts). Use a strong password (12+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Server ----
PORT=5003
# Set to "production" when deployed (enables strict checks)
NODE_ENV=development
# Frontend URLs allowed to call this API, comma separated (no trailing slash)
CLIENT_ORIGINS=http://localhost:5110,http://localhost:4000
# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, Nginx...)
# TRUST_PROXY=1

# ---- Email (verification codes) - optional in development ----
# Without these, codes are printed in the backend terminal (development only).
# Gmail: enable 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Google sign-in - optional ----
# OAuth Client ID (Web application) from https://console.cloud.google.com/apis/credentials
# Add your frontend URL (e.g. http://localhost:5110) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
